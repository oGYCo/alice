# -----------------------------------------------------------------------------
# Alice runtime environment (host-run defaults)
# -----------------------------------------------------------------------------
# Note:
# - These defaults are for running Python services on your host machine.
# - docker-compose.yml overrides key service URLs for container-to-container traffic.

# Core
DATABASE_URL=postgresql+asyncpg://alice:alice@localhost:5432/alice?ssl=disable
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
DEBUG=false


# LLM (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM (Ollama on host)
OLLAMA_HOST=http://host.docker.internal:11434

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_HOST=

# Search
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/alice_neo4j

# Frontend (optional)
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=
